# Multimodal RAG Configuration
# Copy this file to .env and configure your settings

# Enable multimodal embedding (set EMBEDDING_ENGINE=multimodal to activate)
EMBEDDING_ENGINE=multimodal

# Ollama configuration (for text embeddings)
EMBEDDING_BASE_PATH=http://localhost:11434
EMBEDDING_MODEL_PREF=nomic-embed-text

# Multimodal specific settings
MULTIMODAL_IMAGE_MODEL=clip-vit-base-patch32
MULTIMODAL_STORAGE_PATH=./storage/multimodal
MULTIMODAL_ENABLE_OCR=true
MULTIMODAL_MAX_IMAGE_SIZE=2000

# Search settings
MULTIMODAL_SEARCH_MODE=enhanced  # Options: text, image, hybrid, enhanced
MULTIMODAL_TOP_K=5
MULTIMODAL_INCLUDE_IMAGES=true

# Performance settings
MULTIMODAL_CONCURRENT_CHUNKS=1
MULTIMODAL_IMAGE_BATCH_SIZE=5

# Collector settings - Enable multimodal processing
COLLECTOR_MULTIMODAL_ENABLED=true
COLLECTOR_EXTRACT_IMAGES=true
COLLECTOR_OCR_LANGUAGES=eng
